# AlphaLab environment configuration
# Copy to .env and adjust. Never commit real .env files.

# --- Application ---
ALPHALAB_ENV=development
ALPHALAB_LOG_LEVEL=INFO
ALPHALAB_LOG_JSON=false

# --- Database ---
ALPHALAB_DB_HOST=localhost
ALPHALAB_DB_PORT=5432
ALPHALAB_DB_USER=alphalab
ALPHALAB_DB_PASSWORD=alphalab
ALPHALAB_DB_NAME=alphalab

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
